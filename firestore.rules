rules_version = '2';

// كل الكتابة تصير من السيرفر (Cloud Functions) بس، والجوال يقرا. إلا حالة الاتصال: كل لاعب يكتب نبضته بنفسه.
service cloud.firestore {
  match /databases/{database}/documents {

    // ملف اللاعب (الاسم، الذهب، المستوى): صاحبه بس يقرا، والسيرفر بس يكتب.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;

      // سجل مبارياته (السيرفر يكتبه لما تخلص كل لعبة). له بس.
      match /history/{game} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // جدول الترتيب: الاسم والصورة والمستوى وعدد الفوز بس. الكل يشوفه.
    match /leaderboard/{uid} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // أبطال الأسبوع وغيرها من المعلومات العامة. الكل يقرا، والسيرفر بس يكتب.
    match /meta/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // الدواوين: الكل يشوفها (الترتيب والأعضاء)، والسيرفر بس يكتب.
    match /clans/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // دردشة الديوان: أعضاؤه بس يقرون، والسيرفر يكتب (بعد ما يخفي الكلام السيء).
    match /clans/{id}/chat/{msg} {
      allow read: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/clans/$(id)).data.members;
      allow write: if false;
    }

    // دردشة صاحبين: dms/{a_b} (المعرفين مرتبين)، والاثنين بس يقرون.
    match /dms/{pair}/msgs/{msg} {
      allow read: if request.auth != null && request.auth.uid in pair.split('_');
      allow write: if false;
    }

    // حالة الاتصال: كل لاعب يكتب نبضته بنفسه (والوقت وقت السيرفر)، وأصحابه وربعه في الديوان يشوفونها.
    match /presence/{uid} {
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        request.auth.uid in get(/databases/$(database)/documents/users/$(uid)).data.get('friends', []) ||
        (get(/databases/$(database)/documents/users/$(uid)).data.get('clan', null) != null &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('clan', null) != null &&
          get(/databases/$(database)/documents/users/$(uid)).data.clan.id ==
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clan.id)
      );
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['t', 'on'])
        && request.resource.data.t == request.time
        && request.resource.data.on is bool;
      allow delete: if false;
    }

    // بطولة الأسبوع: المشاركين ووين وصلوا. الكل يشوفها، والسيرفر بس يكتب.
    match /tours/{week} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // الروم: الكل يقدر يشوف مين فيه وحالته.
    match /rooms/{code} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // الحالة الكاملة للعبة فيها الأدوار والكروت، فممنوع أي أحد يقراها.
    match /games/{code} {
      allow read, write: if false;

      // كل لاعب يقرا نسخته هو بس. ونسخة المتفرج (_watch، ما فيها ولا سر) للي يتفرجون من أصحاب اللاعبين.
      match /views/{uid} {
        allow read: if request.auth != null && (
          request.auth.uid == uid ||
          (uid == '_watch' &&
            request.auth.uid in get(/databases/$(database)/documents/rooms/$(code)).data.get('watchers', []))
        );
        allow write: if false;
      }
    }
  }
}
