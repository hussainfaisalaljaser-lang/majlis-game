rules_version = '2';

// كل الكتابة تصير من السيرفر (Cloud Functions) بس. الجوال يقرا فقط.
service cloud.firestore {
  match /databases/{database}/documents {

    // الروم: الكل يقدر يشوف مين فيه وحالته.
    match /rooms/{code} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // الحالة الكاملة للعبة فيها الأدوار والكروت، فممنوع أي أحد يقراها.
    match /games/{code} {
      allow read, write: if false;

      // كل لاعب يقرا نسخته هو بس.
      match /views/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }
  }
}
